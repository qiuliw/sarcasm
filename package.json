{
  "name": "sarcasm",
  "description": "B站 / 抖音外挂评论面板：Nostr 同步",
  "private": false,
  "version": "0.2.3",
  "type": "module",
  "license": "MIT",
  "author": "qiuliw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiuliw/sarcasm.git"
  },
  "bugs": {
    "url": "https://github.com/qiuliw/sarcasm/issues"
  },
  "homepage": "https://github.com/qiuliw/sarcasm#readme",
  "keywords": [
    "browser-extension",
    "wxt",
    "svelte",
    "bilibili",
    "douyin",
    "nostr",
    "sqlite"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "test:unit": "bun test scripts/unit.test.ts",
    "smoke": "wxt build && bun scripts/smoke.mjs",
    "test": "bun run test:unit && bun run smoke"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.2",
    "@types/sql.js": "^1.4.11",
    "@wxt-dev/module-svelte": "^2.0.4",
    "puppeteer-core": "^25.11.0",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "nostr-tools": "^2.25.2",
    "sql.js": "^1.14.2"
  }
}
